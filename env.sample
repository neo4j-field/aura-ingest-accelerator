# env.sample — copy to .env and fill in your values
# .env is git-ignored; env.sample is safe to commit.

# =============================================================================
# Neo4j / Aura connection
# =============================================================================

# Connection URI. Use neo4j+s:// for Aura or private-link endpoints.
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io:7687

# Bearer-token auth (Aura-generated token — preferred for Aura instances).
# When set, NEO4J_USER / NEO4J_PASSWORD are ignored.
NEO4J_TOKEN=

# Basic auth — used only if NEO4J_TOKEN is not set.
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# =============================================================================
# GCS authentication — ADC path (default)
# =============================================================================

# Path to a service account key JSON file.
# Omit if you are using gcloud user credentials or Workload Identity.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# =============================================================================
# GCS authentication — HMAC / S3-interoperability path (optional)
#
# Use this instead of ADC when your environment lacks access to service account
# JSON files or the gcloud metadata server (e.g. on-prem, certain CI runners).
#
# Generate keys in the GCS Console:
#   Storage → Settings → Interoperability tab → Service account HMAC keys
#
# Access key IDs always begin with "GOOG".
# Both variables must be set together; setting only one raises ValueError.
#
# Requires the optional [hmac] extra:
#   pip install aura-ingest-accelerator[hmac]
# =============================================================================

GCP_HMAC_ACCESS_KEY=GOOGxxxxxxxxxxxxxxxxxxxxxxxxxx
GCP_HMAC_SECRET_KEY=

# =============================================================================
# Databricks authentication — Personal Access Token
#
# Find these in the Databricks workspace:
#   SQL Warehouses → (your warehouse) → Connection Details tab
#     - Server Hostname → DATABRICKS_SERVER_HOSTNAME
#     - HTTP Path       → DATABRICKS_HTTP_PATH
#   User Settings → Developer → Access Tokens → Generate New Token
#     - Token value     → DATABRICKS_TOKEN
#
# Requires the optional [databricks] extra:
#   pip install aura-ingest-accelerator[databricks]
# =============================================================================

DATABRICKS_SERVER_HOSTNAME=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=

# =============================================================================
# Satisfactory save connector — path to a .sav file
#
# Requires the optional [satisfactory] extra, which pulls in a GPL-3.0
# licensed parser (satisfactory-save). See AGENTS.md Known Issues before
# enabling this in a distributed build.
#
# Windows default location:
#   %LOCALAPPDATA%\FactoryGame\Saved\SaveGames\<steam-id>\MySave.sav
# Linux (Steam Proton) default location:
#   ~/.steam/steam/steamapps/compatdata/526870/pfx/drive_c/users/steamuser/AppData/Local/FactoryGame/Saved/SaveGames/<steam-id>/MySave.sav
#
# Requires the optional [satisfactory] extra:
#   pip install aura-ingest-accelerator[satisfactory]
# =============================================================================

SATISFACTORY_SAVE_PATH=/path/to/MySave.sav

# =============================================================================
# Satisfactory docs connector — path to the CommunityResources Docs folder
# (or a direct path to en-US.json / the legacy Docs.json)
#
# No extra required — this file is plain UTF-16 JSON, parsed with the
# standard library only.
#
# Steam: <install>\CommunityResources\Docs\
# Epic:  <install>\CommunityResources\Docs\
# =============================================================================

SATISFACTORY_DOCS_PATH=/path/to/CommunityResources/Docs
